package image_views

templ ImageRemove(imageID string, repos []string) {
<!-- Remove button -->
<button data-dialog-target={"dialog-remove-" + imageID}
	class="w-full h-full flex items-center justify-center gap-2 bg-red-800 hover:bg-red-900 text-white font-bold py-2 px-4 rounded stroke-white border border-neutral-800/50 transition duration-100">
	<svg width="12" height="12" viewBox="-0.5 0 25 25" fill="none" xmlns="http://www.w3.org/2000/svg">
		<path d="M3 21.32L21 3.32001" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
		<path d="M3 3.32001L21 21.32" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
	</svg>
	remove
</button>

<!-- Backdrop -->
<div data-dialog-backdrop={"dialog-remove-" + imageID} data-dialog-backdrop-close="true"
	class="hidden fixed inset-0 z-[999] grid h-screen w-screen place-items-center bg-black bg-opacity-60 backdrop-blur-sm transition-opacity duration-300">

	<!-- Dialog panel -->
	<div data-dialog={"dialog-remove-" + imageID}
		class="relative m-4 w-2/5 min-w-[40%] sm:max-w-[40%] max-w-[90%] min-h-[40%] sm:max-h-[60%] max-h-[80%] border border-neutral-800/50 rounded-lg bg-[#171717] font-sans text-base font-light leading-relaxed text-white antialiased shadow-2xl opacity-0 scale-95 transition duration-200 p-4">

		<div class="w-full h-full p-5 flex flex-col gap-4">
			<h3 class="scroll-m-20 text-2xl font-semibold tracking-tight">
				Are you sure you want to remove this image?
			</h3>

			<div>
				<p>Removing this image will remove it from the following container:</p>
				<div hx-get={"/images/" + imageID + "/containers" } hx-trigger="load" hx-swap="innerHTML"></div>
			</div>

			<div class="flex justify-start gap-2 w-full mt-2">
				<button data-dialog-close="true"
					class="bg-black hover:bg-neutral-900 text-white font-bold py-2 px-4 rounded stroke-white border border-neutral-800/50 transition duration-100">
					cancel
				</button>

				<button hx-target="body" hx-delete={"/images/" + imageID + "/remove" } hx-swap="transition:false"
					class="bg-red-800 hover:bg-red-900 text-white font-bold py-2 px-4 rounded stroke-white border border-neutral-800/50 transition duration-100">
					remove
				</button>
			</div>
		</div>
	</div>
</div>
}