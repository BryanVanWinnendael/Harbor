package container_views

templ ContainerBash(containerID string) {
	<div
		x-data="{ open: false }"
		@keydown.escape.window="open = false"
	>
		<button
			type="button"
			@click="open = true"
			class="w-full h-full flex items-center justify-center gap-2 bg-black hover:bg-neutral-900 text-white font-bold py-2 px-4 rounded border border-neutral-800/50 transition duration-100"
		>
			<svg
				width="14"
				height="14"
				viewBox="0 0 24 24"
				fill="none"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path
					d="M10 10V7C10 5.34315 8.65685 4 7 4C5.34315 4 4 5.34315 4 7C4 8.65685 5.34315 10 7 10H10ZM10 10V14M10 10H14M10 14V17C10 18.6569 8.65685 20 7 20C5.34315 20 4 18.6569 4 17C4 15.3431 5.34315 14 7 14H10ZM10 14H14M14 10H17C18.6569 10 20 8.65685 20 7C20 5.34315 18.6569 4 17 4C15.3431 4 14 5.34315 14 7V10ZM14 10V14M14 14H17C18.6569 14 20 15.3431 20 17C20 18.6569 18.6569 20 17 20C15.3431 20 14 18.6569 14 17V14Z"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				></path>
			</svg>
			cmd
		</button>
		<div
			x-show="open"
			x-cloak
			x-transition.opacity.duration.300ms
			@click.self="open = false"
			class="fixed inset-0 z-[999] flex h-screen w-screen items-center justify-center bg-black bg-opacity-60 p-4 backdrop-blur-sm"
		>
			<div
				x-show="open"
				x-cloak
				x-transition.scale.origin.center.duration.200ms
				class="relative w-full max-w-5xl h-[75vh] overflow-hidden rounded-lg border border-neutral-800/50 bg-[#171717] text-white shadow-2xl"
			>
				<div class="bg-black p-5 h-full flex flex-col">
					<div class="flex items-start gap-3 shrink-0">
						<div class="min-w-0">
							<h3 class="text-xl font-semibold tracking-tight">
								Container terminal
							</h3>
							<p class="mt-2 text-sm leading-6 text-gray-400">
								Execute commands directly inside the container.
							</p>
						</div>
						<button
							type="button"
							@click="open = false"
							class="ml-auto shrink-0 text-gray-500 transition hover:text-gray-200"
						>
							<svg
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path
									d="M6 6L18 18M18 6L6 18"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"
								></path>
							</svg>
						</button>
					</div>
					<div class="mt-8 flex min-h-0 flex-1 flex-col overflow-hidden rounded-lg border border-neutral-800/50 bg-[#0b0b0b]">
						<div
							id={ "console-box-" + containerID }
							class="min-h-0 flex-1 overflow-y-auto overflow-x-auto p-4 font-mono text-sm text-gray-300"
						>
							<div class="text-gray-600">
								Connected to container.
							</div>
						</div>
						<div class="shrink-0 border-t border-neutral-800/50 px-4 py-3">
							<form
								hx-post={ templ.URL("/containers/" + containerID + "/exec") }
								hx-target={ "#console-box-" + containerID }
								hx-swap="beforeend"
								hx-on::after-request="this.reset()"
								class="flex items-center gap-2 font-mono"
							>
								<span
									id={ "console-path-" + containerID }
									class="shrink-0 text-emerald-400"
								>
									/ $
								</span>
								<input
									name="cmd"
									type="text"
									autocomplete="off"
									autocapitalize="off"
									spellcheck="false"
									autofocus
									class="w-full rounded-lg border border-neutral-800/50 bg-transparent px-3 py-2.5 text-sm text-white outline-none transition focus:border-neutral-700"
									placeholder="Enter a command..."
								/>
							</form>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<script>
		document.body.addEventListener('htmx:afterSwap', function (evt) {
			const consoleContent = document.getElementById('console-box-{{ containerID }}');

			if (consoleContent && evt.target.matches('#console-box-{{ containerID }}')) {
				consoleContent.scrollTop = consoleContent.scrollHeight;
			}
		});
	</script>
}
