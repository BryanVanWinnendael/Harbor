package container_views

templ ContainerRemove(containerID string) {
	<button
		type="button"
		data-dialog-target={ "dialog-remove-container-" + containerID }
		class="w-full h-full flex items-center justify-center gap-2 bg-red-800 hover:bg-red-900 text-white font-bold py-2 px-4 rounded border border-neutral-800/50 transition duration-100"
	>
		<svg
			width="14"
			height="14"
			viewBox="0 0 24 24"
			fill="none"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path
				d="M6 7H18M10 11V17M14 11V17M8 7L9 21H15L16 7M9 7L10 4H14L15 7M4 7H20"
				stroke="currentColor"
				stroke-width="1.5"
				stroke-linecap="round"
				stroke-linejoin="round"
			></path>
		</svg>
		remove
	</button>
	<div
		data-dialog-backdrop={ "dialog-remove-container-" + containerID }
		data-dialog-backdrop-close="true"
		class="hidden fixed inset-0 z-[999] flex h-screen w-screen items-center justify-center bg-black bg-opacity-60 backdrop-blur-sm transition-opacity duration-300 p-4"
	>
		<div
			data-dialog={ "dialog-remove-container-" + containerID }
			class="relative w-full max-w-md overflow-hidden rounded-lg border border-neutral-800/50 bg-[#171717] text-white shadow-2xl opacity-0 scale-95 transition duration-200"
		>
			<div class="bg-black p-5">
				<div class="flex items-start gap-4">
					<div class="min-w-0">
						<h3 class="text-xl font-semibold tracking-tight">
							Remove container?
						</h3>
						<p class="mt-2 text-sm leading-6 text-gray-400">
							Are you sure you want to remove this container?
							This action cannot be undone.
						</p>
					</div>
				</div>
				<div class="mt-6 flex justify-end gap-2">
					<button
						type="button"
						data-dialog-close="true"
						class="bg-black hover:bg-neutral-900 text-white font-bold py-2 px-4 rounded border border-neutral-800/50 transition duration-100"
					>
						cancel
					</button>
					<button
						type="button"
						hx-target="body"
						hx-delete={ "/containers/" + containerID + "/remove" }
						hx-swap="transition:false"
						class="flex items-center justify-center gap-2 bg-red-800 hover:bg-red-900 text-white font-bold py-2 px-4 rounded border border-neutral-800/50 transition duration-100"
					>
						remove
					</button>
				</div>
			</div>
		</div>
	</div>
}
