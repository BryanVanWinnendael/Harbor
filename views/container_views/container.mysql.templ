package container_views

templ ContainerMysql() {
	<div x-data="{ open: false }">
		<button
			type="button"
			@click="open = true"
			class="w-fit h-full flex items-center justify-center gap-2 bg-indigo-400 hover:bg-indigo-500 text-white font-bold py-2 px-4 rounded border border-neutral-800/50 transition duration-100"
		>
			<svg
				width="12"
				height="12"
				viewBox="0 0 24 24"
				fill="none"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path
					d="M4 12H20M12 4V20"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				></path>
			</svg>
			MySQL
		</button>
		<div
			x-show="open"
			x-cloak
			x-transition.opacity.duration.300ms
			@click.self="open = false"
			class="fixed inset-0 z-[999] flex h-screen w-screen items-center justify-center bg-black bg-opacity-60 p-4 backdrop-blur-sm"
		>
			<div
				x-show="open"
				x-cloak
				x-transition.scale.origin.center.duration.200ms
				class="relative w-full max-w-md overflow-hidden rounded-lg border border-neutral-800/50 bg-[#171717] text-white shadow-2xl"
			>
				<form
					hx-swap="transition:true"
					hx-headers="js:{'X-TimeZone': Intl.DateTimeFormat().resolvedOptions().timeZone}"
					class="bg-black p-5"
					action="/mysql/create"
					method="post"
				>
					<div class="flex items-start gap-3">
						<div class="min-w-0">
							<h3 class="text-xl font-semibold tracking-tight">
								Setup MySQL
							</h3>
							<p class="mt-2 text-sm leading-6 text-gray-400">
								Create a new MySQL container and configure its
								database credentials.
							</p>
						</div>
						<button
							type="button"
							@click="open = false"
							class="ml-auto shrink-0 text-gray-500 transition hover:text-gray-200"
						>
							<svg
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path
									d="M6 6L18 18M18 6L6 18"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"
								></path>
							</svg>
						</button>
					</div>
					<div class="mt-8 flex flex-col gap-5">
						<label class="flex flex-col gap-2 text-sm font-medium text-gray-300">
							Container name
							<input
								autocomplete="off"
								class="w-full rounded-lg border border-neutral-800/50 bg-[#0b0b0b] px-3 py-2.5 text-sm text-white outline-none transition placeholder:text-gray-600 focus:border-neutral-700"
								type="text"
								name="containerName"
								required
							/>
						</label>
						<label class="flex flex-col gap-2 text-sm font-medium text-gray-300">
							Root password
							<input
								data-1p-ignore
								autocomplete="off"
								class="w-full rounded-lg border border-neutral-800/50 bg-[#0b0b0b] px-3 py-2.5 text-sm text-white outline-none transition placeholder:text-gray-600 focus:border-neutral-700"
								type="password"
								name="rootPassword"
								required
							/>
						</label>
						<label class="flex flex-col gap-2 text-sm font-medium text-gray-300">
							Database name
							<input
								autocomplete="off"
								class="w-full rounded-lg border border-neutral-800/50 bg-[#0b0b0b] px-3 py-2.5 text-sm text-white outline-none transition placeholder:text-gray-600 focus:border-neutral-700"
								type="text"
								name="databaseName"
								required
							/>
						</label>
						<label class="flex flex-col gap-2 text-sm font-medium text-gray-300">
							Port
							<input
								autocomplete="off"
								value="3306"
								class="w-full rounded-lg border border-neutral-800/50 bg-[#0b0b0b] px-3 py-2.5 text-sm text-white outline-none transition focus:border-neutral-700"
								type="text"
								name="hostPort"
								required
							/>
						</label>
					</div>
					<div class="mt-8 flex justify-end gap-3">
						<button
							type="button"
							@click="open = false"
							class="bg-black hover:bg-neutral-900 text-white font-bold py-2 px-4 rounded border border-neutral-800/50 transition duration-100"
						>
							cancel
						</button>
						<button
							type="submit"
							class="bg-indigo-400 hover:bg-indigo-500 text-white font-bold py-2 px-4 rounded border border-neutral-800/50 transition duration-100"
						>
							setup
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>
}
